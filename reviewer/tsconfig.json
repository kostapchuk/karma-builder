{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  // Подписи категорий и якоря приезжают из общего ядра — дублировать их нельзя:
  // разъедутся с Mini App.
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "../lib/**/*.ts"]
}
