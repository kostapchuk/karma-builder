# Адрес Worker'а. Локально — wrangler dev, в проде — рабочий домен API.
# Скопировать в .env.local; на Vercel задаётся в переменных проекта.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8788

# Токен, которым дев-мок подписывает initData вне Telegram. Должен совпадать
# с BOT_TOKEN в workers/.dev.vars. Настоящий токен бота сюда не кладут:
# мок выключен в production-сборке.
NEXT_PUBLIC_DEV_BOT_TOKEN=local-dev-bot-token
