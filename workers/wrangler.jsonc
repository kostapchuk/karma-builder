{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "karma-builder-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",

  // database_id подставляется после `wrangler d1 create karma-builder`.
  // Для `wrangler dev --local` и `d1 execute --local` значение не используется.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karma-builder",
      "database_id": "129ccb0d-2b57-4759-8bab-77080e5d4aa7",
      "migrations_dir": "migrations"
    }
  ],

  // Страницу рецензента отдаёт сам Worker, а не отдельный проект Pages:
  // зона pages.dev режется частью провайдеров по DNS и SNI, а ссылку на ревью
  // открывает посторонний человек в обычном браузере — недоступный домен
  // убивает весь сценарий. Собирается из `reviewer/` (`npm run build:reviewer`),
  // в git каталог не попадает.
  "assets": {
    "directory": "../reviewer/dist",
    // Адреса вида /r/{token} — маршрут внутри SPA, файла под ними нет.
    "not_found_handling": "single-page-application",
    // ...но /api/* должен доставаться коду, иначе SPA-фолбэк проглотит 404
    // несуществующего маршрута и отдаст на него HTML.
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // База, от которой строятся ссылки на ревью: <REVIEW_BASE_URL>/r/{token}.
    // Тот же домен, что у API: страница теперь живёт здесь же.
    "REVIEW_BASE_URL": "https://karma-builder-api.xfaseex1.workers.dev",
    // Origin'ы, которым разрешён CORS. "*" — любой: все приватные маршруты
    // авторизуются заголовком initData, а не cookie, поэтому это не дыра.
    "ALLOWED_ORIGINS": "*",
    // Часы жизни ссылки на ревью.
    "REVIEW_TTL_HOURS": "72",
    // username бота без @: из него собирается ?startapp-ссылка в друзья.
    "BOT_USERNAME": "karma_builder_bot"
  },

  // BOT_TOKEN — секрет: wrangler secret put BOT_TOKEN
  // Локально кладётся в .dev.vars (в git не попадает).

  "observability": { "enabled": true }
}
