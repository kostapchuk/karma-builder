{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Тесты живут в Node и импортируют модули Worker'а, поэтому оба набора
    // глобалов нужны одновременно.
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noEmit": true,
    // Тесты импортируют с явным .ts — так их запускает и tsx, и node.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  // Ядро кармы из V1 подключается как есть — оно без React и браузерных API.
  "include": ["src/**/*.ts", "tests/**/*.ts", "../lib/karma/**/*.ts"]
}
